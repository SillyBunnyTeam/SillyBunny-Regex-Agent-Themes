    "styleHooks": {
        "primary": "data-rat-part",
        "root": "data-rat",
        "classesAreRenamedTo": "custom-<name>"
    },
    "narrative": {
        "northStar": "The Swatch Book: the picker is native and silent, the themes are opinionated and complete.",
        "rules": [
            "Inline styles are the contract; the stylesheet only adds what they cannot express.",
            "Style hooks are data-rat-* attributes, never class names.",
            "Never emit {{ or $ followed by a digit.",
            "One line per fragment, except the terminal archetype.",
            "Decorative glyphs are aria-hidden; meaning always exists as text.",
            "Nothing may force horizontal scroll at 360px."
        ],
        "dos": [
            "Show the real component, in the theme, with real data, before the user commits.",
            "Keep each theme's decision visible across all nine archetypes.",
            "State the consequence of a destructive action in the button's own row."
        ],
        "donts": [
            "Ship two themes that differ only in hue.",
            "Let ornament reduce the contrast of tracker content.",
            "Overwrite markup the extension did not write without an explicit action.",
            "Revert on disable."
        ]
    }
}
