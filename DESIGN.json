    "styleHooks": {
        "primary": "data-rat-part",
        "root": "data-rat",
        "motion": "data-rat-motion",
        "classesAreRenamedTo": "custom-<name>"
    },
    "narrative": {
        "overview": "The settings panel is a tool and has no look of its own. The themes are the product and are allowed to be loud.",
        "rules": [
            "Inline styles are the contract. The stylesheet only adds what they cannot do.",
            "Style hooks are data-rat-* attributes, never class names.",
            "Never emit {{ or $ followed by a digit.",
            "One line per fragment, except the terminal archetype.",
            "Decorative characters are aria-hidden. Meaning always exists as text too.",
            "Nothing forces sideways scrolling at 360px."
        ],
        "dos": [
            "Show the card, in the theme, with real data, before anyone commits.",
            "Keep a theme's decision visible in all nine shapes.",
            "Put the consequence of a destructive action in the same row as the button."
        ],
        "donts": [
            "Ship two themes that only differ in hue.",
            "Let decoration cut the contrast of tracker text.",
            "Overwrite HTML the extension did not write without an explicit action.",
            "Revert on disable."
        ]
    }
}
