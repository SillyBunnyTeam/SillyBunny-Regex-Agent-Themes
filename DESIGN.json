{
    "schemaVersion": 1,
    "title": "Regex Agent Themes",
    "extensions": {
        "host": "SillyBunny",
        "hostExtension": "in-chat-agents"
    },
    "tokenContract": {
        "groups": [
            "surface",
            "ink",
            "line",
            "shadow",
            "accents",
            "radius",
            "space",
            "type",
            "glyph"
        ],
        "accentRampLength": 7,
        "escapeHatches": [
            "frame",
            "scan",
            "ornament",
            "extra"
        ],
        "literalColoursOnly": true,
        "hostVariablesAllowedIn": [
            "adaptive"
        ]
    },
